# 当前第一步需要的配置

APP_ENV=dev
API_HOST=127.0.0.1
API_PORT=8000

# 应用日志级别，平时使用 INFO，排查问题时可改为 DEBUG
LOG_LEVEL=INFO

# 模型服务，使用 OpenAI 兼容协议；切换服务时一起修改这三项
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# 联网搜索：ddgs 无需 Key；切换 tavily 时填写下面的 Key
SEARCH_PROVIDER=ddgs
TAVILY_API_KEY=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=cq_agent_assist

# Milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=cq_agent_assist
